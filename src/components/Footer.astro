---
import { siteConfig, socialLinks } from '../data/portfolio';

const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-border">
  <div
    class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-4 px-6 py-8 text-sm text-ink-muted sm:flex-row"
  >
    <p>&copy; {year} {siteConfig.brand}. Built with Astro &amp; Tailwind CSS.</p>

    <div class="flex items-center gap-5">
      {
        socialLinks.map((link) => (
          <a
            href={link.href}
            target={link.href.startsWith('http') ? '_blank' : undefined}
            rel={link.href.startsWith('http') ? 'noreferrer' : undefined}
            class="transition-colors hover:text-ink"
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </div>
</footer>
