---
import ThemeToggle from './ThemeToggle.astro';
import { navLinks, siteConfig } from '../data/portfolio';
---

<header
  class="sticky top-0 z-40 border-b border-border/80 bg-canvas/85 backdrop-blur-md"
>
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between px-6">
    <a
      href="#"
      class="font-mono text-base font-semibold tracking-tight text-ink transition-colors hover:text-accent"
    >
      {siteConfig.brand}<span class="text-accent">.</span>
    </a>

    <div class="flex items-center gap-6">
      <nav aria-label="Primary navigation" class="hidden items-center gap-6 sm:flex">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="text-sm font-medium text-ink-muted transition-colors hover:text-ink"
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <ThemeToggle />
    </div>
  </div>
</header>
