---
import type { Project } from '../data/portfolio';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article
  class="group flex flex-col justify-between rounded-2xl border border-border-card bg-surface p-6 shadow-xs transition-all hover:-translate-y-0.5 hover:border-accent hover:shadow-md"
>
  <div>
    <div class="flex items-start justify-between gap-4">
      <h3 class="text-lg font-semibold text-ink transition-colors group-hover:text-accent">
        {project.title}
      </h3>
      <div class="flex items-center gap-3 text-xs font-medium">
        {
          project.repoUrl && (
            <a
              href={project.repoUrl}
              target="_blank"
              rel="noreferrer"
              class="text-ink-subtle transition-colors hover:text-ink"
            >
              Code
            </a>
          )
        }
        {
          project.liveUrl && (
            <a
              href={project.liveUrl}
              target="_blank"
              rel="noreferrer"
              class="text-accent transition-colors hover:text-accent-hover"
            >
              Live &rarr;
            </a>
          )
        }
      </div>
    </div>

    <p class="mt-3 text-sm leading-relaxed text-ink-muted">
      {project.description}
    </p>
  </div>

  <ul class="mt-6 flex flex-wrap gap-2">
    {
      project.tags.map((tag) => (
        <li class="rounded-md bg-surface-subtle px-2.5 py-1 font-mono text-xs text-ink-muted">
          {tag}
        </li>
      ))
    }
  </ul>
</article>
