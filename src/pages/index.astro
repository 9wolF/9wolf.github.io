---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects, siteConfig, skillGroups } from '../data/portfolio';
---

<BaseLayout
  title={siteConfig.brand}
  description={`${siteConfig.name} — ${siteConfig.role}. ${siteConfig.headline}`}
>
  <!-- Hero -->
  <section class="py-20 sm:py-28">
    <p class="font-mono text-xs font-medium uppercase tracking-widest text-accent">
      {siteConfig.role}
    </p>

    <h1 class="mt-4 max-w-3xl text-4xl font-bold tracking-tight text-ink sm:text-5xl">
      Hi, I'm{' '}
      <span class="bg-gradient-to-r from-grad-from to-grad-to bg-clip-text text-transparent">{siteConfig.name}</span>.
      <span class="mt-2 block text-ink-muted">
        {siteConfig.headline}
      </span>
    </h1>

    <p class="mt-6 max-w-2xl text-base leading-relaxed text-ink-muted sm:text-lg">
      {siteConfig.bio}
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-4">
      <a
        href="#projects"
        class="inline-flex items-center justify-center rounded-lg bg-btn-primary px-5 py-2.5 text-sm font-medium text-btn-primary-text transition-colors hover:bg-btn-primary-hover"
      >
        Explore Projects
      </a>
      <a
        href={siteConfig.githubUrl}
        target="_blank"
        rel="noreferrer"
        class="inline-flex items-center justify-center rounded-lg border border-border-card bg-surface px-5 py-2.5 text-sm font-medium text-ink transition-colors hover:bg-surface-subtle"
      >
        GitHub
      </a>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="scroll-mt-20 border-t border-border py-16">
    <h2 class="text-2xl font-bold tracking-tight text-ink">About</h2>
    <div class="mt-4 max-w-3xl space-y-4 text-ink-muted">
      <p class="leading-relaxed">
        I enjoy building thoughtful software, exploring new frameworks, and turning ideas into
        clean, practical projects. This site serves as a personal space to collect and showcase
        what I'm working on.
      </p>
      <p class="leading-relaxed">
        All starter text, links, tools, and project cards live in{' '}
        <code
          class="rounded border border-border-card/60 bg-surface px-1.5 py-0.5 font-mono text-xs text-ink"
        >
          src/data/portfolio.ts
        </code>{' '}
        so you can personalize everything in one place.
      </p>
    </div>
  </section>

  <!-- Projects -->
  <section id="projects" class="scroll-mt-20 border-t border-border py-16">
    <div class="flex items-end justify-between gap-4">
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-ink">Projects</h2>
        <p class="mt-2 text-sm text-ink-muted">
          A curated collection of things I've built and explored.
        </p>
      </div>
    </div>

    <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <!-- Tools -->
  <section id="tools" class="scroll-mt-20 border-t border-border py-16">
    <h2 class="text-2xl font-bold tracking-tight text-ink">Tools &amp; Technologies</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-3">
      {
        skillGroups.map((group) => (
          <div class="rounded-2xl border border-border-card bg-surface p-6 shadow-xs">
            <h3 class="text-sm font-semibold uppercase tracking-wider text-accent">
              {group.category}
            </h3>
            <ul class="mt-4 flex flex-wrap gap-2">
              {group.items.map((item) => (
                <li class="rounded-md bg-surface-subtle px-2.5 py-1 text-xs font-medium text-ink-muted">
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Connect -->
  <section id="connect" class="scroll-mt-20 border-t border-border py-16">
    <div class="rounded-2xl border border-border-card bg-surface p-8 shadow-xs sm:p-10">
      <h2 class="text-2xl font-bold tracking-tight text-ink">Say Hello</h2>
      <p class="mt-3 max-w-xl text-ink-muted">
        Always happy to connect, chat about software, or hear feedback on any of my projects.
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <a
          href={`mailto:${siteConfig.email}`}
          class="inline-flex items-center justify-center rounded-lg bg-btn-primary px-5 py-2.5 text-sm font-medium text-btn-primary-text transition-colors hover:bg-btn-primary-hover"
        >
          Email Me
        </a>
        <a
          href={siteConfig.githubUrl}
          target="_blank"
          rel="noreferrer"
          class="inline-flex items-center justify-center rounded-lg border border-border-card bg-surface-subtle px-5 py-2.5 text-sm font-medium text-ink transition-colors hover:bg-canvas/50"
        >
          Find me on GitHub
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
